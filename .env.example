# Server-only Google AI Studio / Gemini configuration.
# Create a key at https://aistudio.google.com/app/apikey and put it in .env.
# The current scaffold does not call Gemini, so the key can remain empty.
# Never expose this value through a VITE_ variable or frontend code.
GEMINI_API_KEY=

# Models reserved for the future retrieval and synthesis integration.
GEMINI_ANSWER_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional local server overrides.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
