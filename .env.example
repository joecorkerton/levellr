# Google AI Studio / Gemini API
# Create a key at https://aistudio.google.com/app/apikey and put it in .env.
# Keep only GEMINI_API_KEY set; do not set GOOGLE_API_KEY as well.
GEMINI_API_KEY=

# Model used for constrained answer synthesis.
GEMINI_ANSWER_MODEL=gemini-2.5-flash

# Optional cheaper fallback/fixture model. Do not use this to fabricate an answer
# when the primary call fails; the application should return a typed fallback.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Reserved for a later retrieval experiment; this ticket does not use embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
